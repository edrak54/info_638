<h1>{{book.title}}</h1>
{{#if book.authors}}
<p>  Written by {{#each book.authors}}{{this.firstName}} {{this.lastName}}{{#unless @last}}, {{/unless}}{{/each}}
</p>
{{/if}}
<p>
  First published in {{book.publishingYear}}
</p>
<p>
  {{#if genre}}
    Genre: {{genre.name}}
    {{/if}}
</p>


{{#if currentUser}}
<div>
  <form action="/books_users/upsert" role="form" method="post">
    <input type="hidden" name="_csrf" value="{{_csrfToken}}">
    <input type="hidden" name="bookId" value="{{book.id}}">
    <input type="hidden" name="userId" value="{{currentUser.id}}">
    {{#if bookUser}}
      <input type="hidden" name="id" value="{{bookUser.id}}">
    {{/if}}
    <label for="status">Status</label>
    <select name="readStatus" id="status">
      {{#unless (and bookUser bookUser.readStatus)}}
        <option disabled value selected>-- select status --</option>
      {{/unless}}
      {{#each statuses}}
        <option value="{{this}}" {{#if (and @root.bookUser (eq @root.bookUser.readStatus this))}}selected{{/if}}>{{this}}</option>
      {{/each}}
    </select>
    <button type="submit">Submit</button>
  </form>
</div>
{{/if}}

<h2>Comments:</h2>

{{#if currentUser}}
  <form action="/comments/upsert" role="form" method="post">
    <input type="hidden" name="_csrf" value="{{_csrfToken}}">
    <input type="hidden" name="bookId" value="{{book.id}}">
    <input type="hidden" name="userId" value="{{currentUser.id}}">
    {{!-- <input type="hidden" name="id" value="{{comment.id}}"> --}}
    <label for="text">Comment:</label>
    <br>
    <textarea rows="3" cols="30" id="comment" name="comment">{{comment.comment}}</textarea>
    <br>
    <button type="submit">Post Comment</button>
  </form>
{{/if}}

{{#each comments}}
  <p>
    {{this.comment}}
    <br>
    By: {{this.userEmail}}
    <br>
    {{#if (eq @root.currentUser.id this.id)}}
    <a href="/comments/edit?id={{this.id}}">Edit</a>
    {{/if}}
  </p>
{{/each}}

